# Copy to .env (never commit .env)
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=

# Jira Cloud site (the Forge dev site). Token: id.atlassian.com -> Security -> API tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM

# 1 = print mutating Jira requests instead of sending them
JIRA_DRY_RUN=0
# 1 = allow delete_issue (deleted issues are snapshotted to audit.jsonl first)
ALLOW_DELETE=0

# Meetings database API (SpacetimeDB, see ../spacetimedb). Leave empty to run without saving meetings.
# ARGO_API_BASE looks like https://<host>/v1/database/<db-name>/route
ARGO_API_BASE=
# A secret we make up (openssl rand -hex 32). Must match the API_KEY the module was published with.
ARGO_API_KEY=
